# Copy to .env.demo on the server. .env* is gitignored — keep it that way.
# Generate every secret below; do not reuse a value from .env.example, which is
# published in the repo and is development-only by design.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- database credentials -------------------------------------------------
# These are consumed by docker-compose.demo.yml, which builds the DSNs from them
# using container hostnames. Do not put 127.0.0.1 DSNs here.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
NEO4J_PASSWORD=

# --- Cloudflare -----------------------------------------------------------
# From: Cloudflare dashboard > Zero Trust > Networks > Tunnels > your tunnel >
# Install connector. The token embeds the tunnel credentials, so treat it as one.
CLOUDFLARE_TUNNEL_TOKEN=

# --- session --------------------------------------------------------------
# Sessions are installed ONLY when this is set; empty means every authenticated
# endpoint answers 503 rather than handing out cookies anybody could forge.
MERIDIAN_SESSION_SECRET=

# --- OIDC -----------------------------------------------------------------
# DELIBERATELY EMPTY. Keycloak is cut from this stack, and an unset issuer
# disables the login route rather than guessing a provider. Setting this without
# a reachable IdP would mount a login path that cannot complete.
MERIDIAN_OIDC_ISSUER=

# --- NOT SET, ON PURPOSE --------------------------------------------------
# MERIDIAN_DEV_AUTO_AUTH — do not add this line. While the default remains
# fail-open (#191), any truthy value here authenticates every anonymous request
# as the first principal by created_at: Raj Malhotra, founder, clearance 4.
#
# docker-compose.demo.yml pins ENVIRONMENT=production as defence-in-depth. That
# protects this deployment only; it is not the fix and production safety does not
# depend on it. The fix is the fail-closed allowlist in #191.

# --- demo principal selector ---------------------------------------------
# READ THIS BEFORE SETTING IT.
#
# Setting this to "true" means ANY visitor who can reach this deployment may assume
# any of the three seeded demo identities — founder, exec, investor — without a
# password. It is an impersonation endpoint, deliberately, because the whole demo is
# "watch the same request return different material as different people".
#
# It is safe HERE and only here because this deployment serves fabricated board
# minutes from data/demo/ and nothing else. The containment is not the flag: it is
# that this database contains no real data. Never set this against real data, and
# never copy this file to a deployment that has any.
#
# Absent means off, which is the state every other environment is in.
MERIDIAN_DEMO_SELECTOR=true

# The seeded Board Meeting 14 pack. Read it from the database after seeding:
#   docker compose -f docker-compose.demo.yml exec postgres \
#     psql -U callosum -d callosum -tAc "SELECT id FROM board_pack LIMIT 1"
# It is REGENERATED BY EVERY SEED, so it cannot be hardcoded. Two clean runs produced
# 6c43d827-... and 66875926-... The demo page renders "not configured" when it is
# absent rather than guessing at a pack.
NEXT_PUBLIC_DEMO_PACK_ID=

# --- model provider ------------------------------------------------------
# DELIBERATELY UNSET, and the demo needs nothing here.
#
# Verified against master: the only `llm.embed` call in the whole Meridian API is
# inside `intake_document` (meridian/documents.py:454), reached from the POST
# /documents/intake route. No read path embeds, and no API route generates prose at
# all — `callosum.retrieve.ask()` is called only from cli.py:346 and evaluate.py.
#
# A read-only demo therefore makes ZERO model calls: no Ollama, no API key, no
# tailnet dependency on your main machine, no spend cap to configure, and no abuse
# surface. Ingest happens on your main machine and arrives as a database dump.
#
# Set these only if you deliberately expose /documents/intake, which the demo
# should not.
# PROVIDER=ollama
# OLLAMA_HOST=
# OLLAMA_EMBEDDING_MODEL=bge-m3
