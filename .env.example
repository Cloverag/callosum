# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Provider: "ollama" (free, default) or "anthropic" (needs credits)
#
# Both paths are live. Ollama is the default so the whole project runs at zero
# cost. The Anthropic path stays wired so Phase 7 can measure open-weight vs
# frontier extraction quality over the same corpus — the model doing the
# extracting determines the quality of the graph, so it is a research variable,
# not an implementation detail.
# ---------------------------------------------------------------------------
PROVIDER=ollama

# --- Ollama (default) ---
# Cloud chat model. Requires `ollama signin` once.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
# Embeddings run locally and free. bge-m3 is 1024-dim, matching VECTOR(1024).
#   ollama pull bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Anthropic (only needed when PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Stores (defaults match docker-compose.yml) ---
POSTGRES_DSN=postgresql://callosum:callosum@localhost:5433/callosum
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=callosum123

# --- Meridian API: OIDC + session (P3, ADR-009) ---
# Defaults match the keycloak service in docker-compose.yml. NOTHING here has a
# working default in code — an unset issuer disables auth rather than guessing one,
# and an unset session secret means no session middleware is installed at all.
MERIDIAN_OIDC_ISSUER=http://localhost:8080/realms/meridian
MERIDIAN_OIDC_CLIENT_ID=meridian-api
MERIDIAN_OIDC_CLIENT_SECRET=dev-client-secret-change-me
MERIDIAN_OIDC_REDIRECT_URL=http://localhost:8000/auth/callback

# Sign the session cookie. Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signing key for the session cookie. Sessions are installed ONLY when this is set,
# so leaving it empty means every authenticated endpoint answers 503 rather than
# handing out cookies anybody could forge.
#
# The value below is fine for local development and MUST NOT be used anywhere else.
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MERIDIAN_SESSION_SECRET=dev-only-not-for-deployment-3f9c1a7e5b2d8460
# Local HTTP development only. Must be true anywhere reachable over a network.
MERIDIAN_SESSION_HTTPS_ONLY=false
