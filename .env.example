# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Provider: "ollama" (free, default) or "anthropic" (needs credits)
#
# Both paths are live. Ollama is the default so the whole project runs at zero
# cost. The Anthropic path stays wired so Phase 7 can measure open-weight vs
# frontier extraction quality over the same corpus — the model doing the
# extracting determines the quality of the graph, so it is a research variable,
# not an implementation detail.
# ---------------------------------------------------------------------------
PROVIDER=ollama

# --- Ollama (default) ---
# Cloud chat model. Requires `ollama signin` once.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
# Embeddings run locally and free. bge-m3 is 1024-dim, matching VECTOR(1024).
#   ollama pull bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Anthropic (only needed when PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Stores (defaults match docker-compose.yml) ---
POSTGRES_DSN=postgresql://callosum:callosum@localhost:5433/callosum
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=callosum123
